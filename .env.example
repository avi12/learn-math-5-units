# The one config file for every part of the project. Copy to `.env` and fill in from your
# Firebase project: console -> Project settings -> Your apps -> Web app -> SDK config.
#
# The web config is not a secret (every browser receives it), but it is YOUR project: the
# source never names one, so a fork writes to its own database and not to someone else's.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Where the pad is served; defaults to https://<project id>.web.app.
# The extension listens on it and the Android wrapper opens it.
# PAD_ORIGIN=
