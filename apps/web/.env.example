# Copy to `.env` and fill in from your Firebase project:
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# The web config is not a secret (every browser receives it), but it is YOUR project:
# the code never names one, so a fork writes to its own database and not to someone else's.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
