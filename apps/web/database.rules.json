{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.length == 32",
        ".write": "$room.length == 32",
        "strokes": {
          "$stroke": {
            ".validate": "newData.hasChildren(['t','c','w','p']) && newData.child('p').isString() && newData.child('p').val().length < 40000"
          }
        },
        "live": {
          ".validate": "!newData.exists() || (newData.hasChildren(['t','c','w','p']) && newData.child('p').val().length < 40000)"
        },
        "presence": {
          "$device": { ".validate": "newData.hasChild('role')" }
        }
      }
    }
  }
}
