{
  "name": "avi-math-study",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "deploy": "npm run build && python scripts/deploy.py",
    "deploy:cli": "npm run build && firebase deploy",
    "apk": "python scripts/apk.py",
    "apk:install": "python scripts/apk.py --install",
    "lint": "oxlint --type-aware --fix -c .oxlintrc.fix.json && eslint --fix && oxlint --type-aware",
    "stylelint": "stylelint \"src/**/*.{svelte,css}\" --fix",
    "fallow": "fallow audit --base HEAD"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.12.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "^2.103.0",
    "globals": "^17.13.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "postcss": "^8.5.28",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "temml": "0.13.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "description": "Handwriting pad for maths: draw on the tablet, watch on the desktop, copy as an image."
}
