{
  "name": "learn-math-5-units",
  "private": true,
  "repository": "github:avi12/learn-math-5-units",
  "type": "module",
  "description": "5-unit math bagrut: the pad app, its Android wrapper, the Chrome extension, and the workbook with its Claude examiner.",
  "author": "Avi (https://avi12.com)",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/avi12/learn-math-5-units",
  "scripts": {
    "check": "pnpm --filter @learn-math/web run check && pnpm --filter @learn-math/extension run compile",
    "build": "pnpm --filter @learn-math/web run build && pnpm --filter @learn-math/extension run build",
    "lint": "oxlint --type-aware --fix -c .oxlintrc.fix.json && eslint --fix && oxlint --type-aware",
    "stylelint": "stylelint \"apps/web/src/**/*.{svelte,css}\" --fix",
    "deploy": "pnpm --filter @learn-math/web run deploy",
    "apk": "python apps/android/apk.py",
    "apk:install": "python apps/android/apk.py --install"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "^2.103.0",
    "globals": "^17.13.0",
    "oxlint": "~1.72.0",
    "oxlint-tsgolint": "~0.24.0",
    "postcss": "^8.5.28",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "@types/node": "^24.13.3"
  }
}
